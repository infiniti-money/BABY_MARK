{
  "name": "babymark-cloudflare",
  "version": "1.2.0-rc.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "backup:local": "node scripts/backup-local.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test cloudflare/tests/*.test.mjs tests/*.test.mjs",
    "test:browser": "playwright test",
    "dev": "npm run build && wrangler pages dev dist --port 8788",
    "check:runtime": "npm run build && wrangler pages functions build functions --outdir work/functions-build --compatibility-date 2026-11-24",
    "demo": "npm run check:runtime && node scripts/local-test-server.mjs --demo"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "miniflare": "5.20261123.0-beta",
    "wrangler": "4.167.0"
  }
}
