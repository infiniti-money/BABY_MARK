{
  "expo": {
    "name": "BABY MARK Staff",
    "slug": "baby-mark-staff",
    "version": "0.4.0",
    "ios": {
      "bundleIdentifier": "com.infinitimoney.babymark",
      "supportsTablet": false
    },
    "android": {
      "package": "com.infinitimoney.babymark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "BABY_MARK cần camera để chụp ảnh chấm công.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BABY_MARK cần vị trí khi chấm công."
        }
      ],
      "expo-notifications"
    ],
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7F7"
    }
  }
}
